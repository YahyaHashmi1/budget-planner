# --- PostgreSQL (used by the db container) ---
POSTGRES_USER=paycheck_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=paycheck_tracker

# --- API (used by the FastAPI app) ---
# Inside Docker Compose, the host is the service name "db", not "localhost"
DATABASE_URL=postgresql+asyncpg://paycheck_user:change_me@db:5432/paycheck_tracker

# --- App settings ---
ENVIRONMENT=development
LOG_LEVEL=info